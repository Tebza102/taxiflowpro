# Frontend runtime
VITE_BACKEND_MODE=live
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase access (never expose these values in frontend code)
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_WORKSPACE_KEY=taxiflow-live

# Logbook photo import (server only; never prefix with VITE_). The model id is
# chosen here, not in code; the key is used only by /api/logbook/extract.
LOGBOOK_VISION_MODEL=your-vision-model-id
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# One-time Owner-first reset script. Set these only in the secure shell/session
# used to perform the reset; do not commit real values.
TAXIFLOW_BOOTSTRAP_OWNER_EMAIL=owner@example.com
TAXIFLOW_BOOTSTRAP_OWNER_PASSWORD=replace-with-secure-password
TAXIFLOW_BOOTSTRAP_OWNER_NAME=TaxiFlow Owner
TAXIFLOW_CONFIRM_OWNER_RESET=RESET_TAXIFLOW_PRODUCTION_USERS
