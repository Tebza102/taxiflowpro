{"type":"frame-snapshot","snapshot":{"callId":"call@29","snapshotName":"after@call@29","pageId":"page@8e16bedf3b18b7de9c7fcc03a96108b1","frameId":"frame@a38ba8d4e501edf58f59e004819d2910","frameUrl":"http://127.0.0.1:4173/","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:4173/"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0, viewport-fit=cover"}],"\n    ",["META",{"name":"description","content":"TaxiFlow Pro is a mobile-first ERP command centre for South African minibus taxi operators."}],"\n    ",["META",{"name":"theme-color","content":"#0B2545"}],"\n    ",["LINK",{"rel":"manifest","href":"/manifest.webmanifest"}],"\n    ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/icon.svg"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"192x192","href":"/pwa-192.png"}],"\n    ",["LINK",{"rel":"apple-touch-icon","sizes":"192x192","href":"/pwa-192.png"}],"\n    ",["TITLE",{},"TaxiFlow Pro"],"\n  ",["STYLE",{},":root {\n  color-scheme: light;\n  --navy: #0b2545;\n  --teal: #1bc5bd;\n  --gold: #f4d03f;\n  --success: #27ae60;\n  --warning: #f39c12;\n  --danger: #e74c3c;\n  --info: #3498db;\n  --text: #1a1a1a;\n  --subtext: #444444;\n  --muted: #888888;\n  --border: #d3d3d3;\n  --bg: #f5f5f5;\n  --white: #ffffff;\n  --shadow: 0 10px 26px rgba(11, 37, 69, 0.08);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  font-size: 16px;\n}\n\nbody {\n  margin: 0;\n  min-width: 320px;\n  min-height: 100vh;\n  background: linear-gradient(180deg, #eef2f6 0%, #f6f7f9 100%);\n  color: var(--text);\n  font-family: \"Aptos\", \"Segoe UI\", sans-serif;\n}\n\nbutton,\ninput,\nselect,\ntextarea {\n  font: inherit;\n}\n\nbutton {\n  cursor: pointer;\n}\n\n#root {\n  min-height: 100vh;\n}\n\n.app-shell {\n  position: relative;\n  min-height: 100vh;\n  overflow-x: hidden;\n  padding: 0.75rem;\n}\n\n.ambient {\n  display: none;\n}\n\n.app-canvas {\n  display: flex;\n  flex-direction: column;\n  min-height: calc(100vh - 1.5rem);\n  background: rgba(255, 255, 255, 0.95);\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  border-radius: 1.6rem;\n  box-shadow: 0 18px 40px rgba(11, 37, 69, 0.08);\n}\n\n.loading-shell {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 1.5rem;\n}\n\n.loading-card {\n  width: min(100%, 26rem);\n  padding: 2rem;\n  border-radius: 1.75rem;\n  background: rgba(255, 255, 255, 0.88);\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  box-shadow: var(--shadow);\n  text-align: center;\n}\n\n.loading-card h1 {\n  margin: 0.5rem 0 0;\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1.55rem;\n  line-height: 1.2;\n  color: var(--navy);\n}\n\n.auth-shell {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 1.5rem;\n}\n\n.auth-card {\n  display: grid;\n  gap: 1.1rem;\n  width: min(100%, 28rem);\n  padding: 1.8rem;\n  border-radius: 1.75rem;\n  background: rgba(255, 255, 255, 0.92);\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  box-shadow: var(--shadow);\n}\n\n.auth-brand {\n  justify-content: center;\n  width: 100%;\n}\n\n.auth-logo {\n  width: auto;\n  height: 11rem;\n  max-width: min(18rem, 72vw);\n  filter: drop-shadow(0 12px 24px rgba(11, 37, 69, 0.12));\n}\n\n.auth-copy {\n  display: grid;\n  gap: 0.45rem;\n  justify-items: center;\n  text-align: center;\n}\n\n.auth-copy h1 {\n  margin: 0;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: clamp(1.55rem, 4vw, 2.3rem);\n  line-height: 1.04;\n}\n\n.auth-copy p:last-child {\n  margin: 0;\n  color: var(--subtext);\n}\n\n.auth-provider-note {\n  display: inline-flex;\n  align-items: center;\n  width: -moz-fit-content;\n  width: fit-content;\n  padding: 0.28rem 0.55rem;\n  border-radius: 999px;\n  background: rgba(11, 37, 69, 0.06);\n  color: var(--navy);\n  font-size: 0.72rem;\n  font-weight: 700;\n}\n\n.auth-form {\n  display: grid;\n  gap: 0.9rem;\n}\n\n.spin {\n  animation: spin 1.2s linear infinite;\n  color: var(--teal);\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.brand-lockup {\n  display: flex;\n  align-items: center;\n  gap: 0.9rem;\n}\n\n.brand-lockup.compact {\n  gap: 1rem;\n}\n\n.brand-logo {\n  display: block;\n  width: auto;\n  height: 9.6rem;\n  max-width: 100%;\n  -o-object-fit: contain;\n     object-fit: contain;\n  filter: drop-shadow(0 10px 24px rgba(11, 37, 69, 0.16));\n}\n\n.brand-logo.compact {\n  width: auto;\n  height: 7.8rem;\n  filter: drop-shadow(0 14px 28px rgba(11, 37, 69, 0.16));\n}\n\n.toolbar-logo {\n  width: auto;\n  height: 6rem;\n  filter: drop-shadow(0 10px 20px rgba(11, 37, 69, 0.14));\n}\n\n.brand-mark {\n  display: grid;\n  place-items: center;\n  width: 3rem;\n  height: 3rem;\n  border-radius: 1rem;\n  background:\n    linear-gradient(140deg, rgba(11, 37, 69, 1), rgba(11, 37, 69, 0.92)),\n    linear-gradient(140deg, rgba(27, 197, 189, 1), rgba(244, 208, 63, 1));\n  color: var(--white);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  box-shadow: 0 10px 30px rgba(11, 37, 69, 0.24);\n}\n\n.brand-mark.compact {\n  width: 2.15rem;\n  height: 2.15rem;\n  border-radius: 0.72rem;\n  font-size: 0.86rem;\n  box-shadow: 0 8px 20px rgba(11, 37, 69, 0.14);\n}\n\n.topbar h1,\n.app-toolbar h1,\n.hero-card h2,\n.panel-head h2,\n.metric-card strong,\n.vehicle-card h3,\n.queue-card h3,\n.status-row h3,\n.timeline-row h3,\n.person-row h3 {\n  margin: 0;\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  letter-spacing: -0.02em;\n}\n\n.topbar h1,\n.app-toolbar h1 {\n  font-size: 1.18rem;\n  color: var(--navy);\n}\n\n.topbar-meta,\n.hero-text,\n.metric-card p,\n.panel-note,\n.status-row p,\n.timeline-row p,\n.feature-card p,\n.architecture-card p,\n.queue-card p,\n.vehicle-card p,\n.deposit-card p,\n.person-row p {\n  margin: 0;\n  color: var(--subtext);\n}\n\n.eyebrow {\n  margin: 0;\n  color: var(--muted);\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.role-switcher {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.45rem;\n}\n\n.role-switcher.inline {\n  justify-content: flex-end;\n  align-items: center;\n}\n\n.role-pill,\n.bottom-nav-item,\n.shortcut-button,\n.cta-link {\n  -webkit-appearance: none;\n     -moz-appearance: none;\n          appearance: none;\n  border: 0;\n  transition:\n    transform 180ms ease,\n    background-color 180ms ease,\n    color 180ms ease,\n    border-color 180ms ease,\n    box-shadow 180ms ease;\n}\n\n.role-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  justify-content: center;\n  border-radius: 999px;\n  padding: 0.65rem 0.95rem;\n  background: rgba(255, 255, 255, 0.88);\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  color: var(--navy);\n  font-size: 0.88rem;\n  font-weight: 700;\n}\n\n.role-pill.compact {\n  padding: 0.42rem 0.72rem;\n  font-size: 0.72rem;\n}\n\n.role-pill.active,\n.role-pill:hover {\n  background: var(--navy);\n  color: var(--white);\n  transform: translateY(-1px);\n}\n\n.page-shell {\n  flex: 1;\n  display: grid;\n  gap: 0.85rem;\n  padding: 0.85rem 0.95rem 6rem;\n}\n\n.app-footer {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.35rem 0.55rem;\n  padding: 0 1.25rem 1.1rem;\n  border-top: 1px solid rgba(11, 37, 69, 0.08);\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-align: center;\n}\n\n.app-footer a {\n  color: var(--navy);\n  text-decoration: none;\n}\n\n.app-footer a:hover {\n  text-decoration: underline;\n}\n\n.app-toolbar {\n  display: grid;\n  gap: 0.5rem;\n  padding-bottom: 0.15rem;\n}\n\n.toolbar-actions,\n.toolbar-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n}\n\n.toolbar-actions {\n  justify-content: space-between;\n  align-items: center;\n}\n\n.toolbar-meta {\n  align-items: center;\n}\n\n.auth-session-panel {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 0.55rem;\n}\n\n.auth-session-copy {\n  display: grid;\n  gap: 0.12rem;\n  min-width: min(100%, 12rem);\n  text-align: right;\n}\n\n.auth-session-copy strong {\n  color: var(--navy);\n  font-size: 0.82rem;\n  line-height: 1.1;\n}\n\n.auth-session-copy span {\n  color: var(--subtext);\n  font-size: 0.72rem;\n}\n\n.toolbar-meta .status-chip {\n  padding: 0.34rem 0.66rem;\n  font-size: 0.68rem;\n}\n\n.backend-mode-panel {\n  display: grid;\n  gap: 0.35rem;\n  min-width: min(100%, 16rem);\n  padding: 0.65rem 0.75rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  border-radius: 1rem;\n  background: rgba(255, 255, 255, 0.9);\n  box-shadow: 0 8px 20px rgba(11, 37, 69, 0.06);\n}\n\n.backend-mode-head {\n  display: flex;\n  align-items: center;\n  gap: 0.55rem;\n  color: var(--navy);\n}\n\n.backend-mode-head strong {\n  display: block;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 0.9rem;\n}\n\n.backend-mode-switch {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.backend-mode-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.backend-mode-switch .role-pill {\n  min-width: 4.1rem;\n  justify-content: center;\n}\n\n.backend-mode-switch .role-pill:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n  transform: none;\n}\n\n.backend-mode-note {\n  margin: 0;\n  color: var(--subtext);\n  font-size: 0.72rem;\n  line-height: 1.35;\n}\n\n.topbar-meta {\n  font-size: 0.76rem;\n  color: var(--subtext);\n}\n\n.hero-card,\n.panel-card,\n.metric-card {\n  position: relative;\n  background: rgba(255, 255, 255, 0.9);\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  border-radius: 1.6rem;\n  box-shadow: var(--shadow);\n}\n\n.hero-card {\n  display: grid;\n  gap: 1.4rem;\n  padding: 1.45rem;\n  overflow: hidden;\n}\n\n.hero-card.hero-card-minimal {\n  gap: 1rem;\n}\n\n.hero-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 0 auto;\n  height: 0.36rem;\n  background: linear-gradient(90deg, var(--navy), var(--teal), var(--gold));\n}\n\n.hero-copy {\n  display: grid;\n  gap: 1rem;\n}\n\n.hero-copy.hero-copy-minimal {\n  gap: 0.65rem;\n}\n\n.hero-card h2 {\n  font-size: clamp(1.9rem, 5vw, 3.35rem);\n  line-height: 0.98;\n  color: var(--navy);\n}\n\n.hero-copy-minimal h2 {\n  font-size: clamp(1.55rem, 4vw, 2.6rem);\n  line-height: 1.02;\n  max-width: 18ch;\n}\n\n.hero-text {\n  max-width: 42rem;\n  line-height: 1.65;\n  font-size: 1rem;\n}\n\n.tag-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.65rem;\n}\n\n.hero-meta-strip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.65rem;\n}\n\n.metric-grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.analytics-grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.analytics-grid.overview-analytics {\n  gap: 0.7rem;\n}\n\n.metric-grid.tight {\n  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));\n}\n\n.metric-card {\n  display: grid;\n  gap: 0.65rem;\n  padding: 1.15rem;\n}\n\n.metric-card::before,\n.panel-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 0.24rem;\n  border-radius: 1.6rem 0 0 1.6rem;\n  background: rgba(11, 37, 69, 0.08);\n}\n\n.metric-card[data-tone=\"success\"]::before,\n.status-chip[data-tone=\"success\"],\n.bar-fill {\n  background: linear-gradient(135deg, var(--success), #4cc37c);\n}\n\n.metric-card[data-tone=\"warning\"]::before,\n.status-chip[data-tone=\"warning\"] {\n  background: linear-gradient(135deg, var(--warning), #f6b13d);\n}\n\n.metric-card[data-tone=\"danger\"]::before,\n.status-chip[data-tone=\"danger\"] {\n  background: linear-gradient(135deg, var(--danger), #ee6d61);\n}\n\n.metric-card[data-tone=\"info\"]::before,\n.status-chip[data-tone=\"info\"] {\n  background: linear-gradient(135deg, var(--info), #59ade6);\n}\n\n.status-chip[data-tone=\"navy\"] {\n  background: linear-gradient(135deg, var(--navy), #173861);\n}\n\n.metric-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n}\n\n.metric-icon,\n.panel-icon {\n  display: grid;\n  place-items: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  border-radius: 0.9rem;\n  background: rgba(11, 37, 69, 0.06);\n  color: var(--navy);\n}\n\n.metric-card strong {\n  font-size: 1.65rem;\n  color: var(--navy);\n}\n\n.metric-card p {\n  font-size: 0.92rem;\n  line-height: 1.5;\n}\n\n.section-nav {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.55rem;\n}\n\n.module-button {\n  display: grid;\n  gap: 0.35rem;\n  min-height: 5.3rem;\n  padding: 0.8rem 0.9rem;\n  border-radius: 0.95rem;\n  background: #ffffff;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  color: var(--subtext);\n  text-align: left;\n  box-shadow: 0 6px 14px rgba(11, 37, 69, 0.04);\n}\n\n.module-button:hover,\n.module-button.active {\n  transform: none;\n  background: rgba(11, 37, 69, 0.98);\n  color: var(--white);\n  box-shadow: 0 10px 20px rgba(11, 37, 69, 0.12);\n}\n\n.module-button-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.module-button-icon {\n  display: grid;\n  place-items: center;\n  width: 1.45rem;\n  height: 1.45rem;\n  border-radius: 0.45rem;\n  background: rgba(11, 37, 69, 0.06);\n  color: var(--navy);\n}\n\n.module-button.active .module-button-icon,\n.module-button:hover .module-button-icon {\n  background: rgba(255, 255, 255, 0.12);\n  color: var(--white);\n}\n\n.module-button-head strong {\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 0.88rem;\n  letter-spacing: -0.02em;\n}\n\n.module-button-label {\n  font-size: 0.92rem;\n  font-weight: 800;\n  color: inherit;\n}\n\n.module-button-sub {\n  color: var(--muted);\n  font-size: 0.64rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.module-button.active .module-button-sub,\n.module-button:hover .module-button-sub {\n  color: rgba(255, 255, 255, 0.72);\n}\n\n.finance-module-nav {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  gap: 0.55rem;\n}\n\n.finance-access-card {\n  gap: 1rem;\n}\n\n.finance-shortcut-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.65rem;\n}\n\n.finance-shortcut-button {\n  margin-top: 0;\n  min-height: 3rem;\n}\n\n.finance-entry-board {\n  scroll-margin-top: 1rem;\n}\n\n.finance-mode-button {\n  display: grid;\n  gap: 0.35rem;\n  min-height: 5.2rem;\n  padding: 0.8rem 0.9rem;\n  border-radius: 0.95rem;\n  background: #ffffff;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  color: var(--subtext);\n  text-align: left;\n  box-shadow: 0 6px 14px rgba(11, 37, 69, 0.04);\n}\n\n.finance-mode-button.active {\n  background: rgba(11, 37, 69, 0.98);\n  color: var(--white);\n  box-shadow: 0 10px 20px rgba(11, 37, 69, 0.12);\n}\n\n.finance-mode-button.active .module-button-icon {\n  background: rgba(255, 255, 255, 0.12);\n  color: var(--white);\n}\n\n.finance-mode-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.finance-sub-switch {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n}\n\n.fleet-toolbar {\n  align-items: center;\n}\n\n.finance-sub-pill {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.4rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: #ffffff;\n  color: var(--navy);\n  border-radius: 999px;\n  padding: 0.45rem 0.8rem;\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.finance-sub-pill.active {\n  background: rgba(11, 37, 69, 0.98);\n  color: var(--white);\n}\n\n.finance-sub-pill:disabled {\n  opacity: 0.52;\n  cursor: not-allowed;\n}\n\n.finance-sub-pill-action {\n  border-color: rgba(11, 37, 69, 0.18);\n  background: rgba(11, 37, 69, 0.98);\n  color: var(--white);\n}\n\n.finance-board-grid {\n  display: grid;\n  gap: 0.85rem;\n  align-items: start;\n}\n\n.finance-feedback {\n  display: flex;\n}\n\n.finance-form,\n.finance-ledger {\n  display: grid;\n  gap: 0.8rem;\n  align-content: start;\n}\n\n.finance-form-grid {\n  display: grid;\n  gap: 0.7rem;\n}\n\n.finance-field {\n  display: grid;\n  gap: 0.35rem;\n}\n\n.finance-field span {\n  color: var(--muted);\n  font-size: 0.66rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.finance-field input,\n.finance-field select {\n  width: 100%;\n  min-height: 2.8rem;\n  padding: 0.7rem 0.8rem;\n  border: 1px solid rgba(11, 37, 69, 0.1);\n  border-radius: 0.85rem;\n  background: rgba(245, 247, 250, 0.9);\n  color: var(--navy);\n}\n\n.finance-field-wide {\n  grid-column: 1 / -1;\n}\n\n.finance-field-check {\n  align-content: end;\n}\n\n.finance-field-check input {\n  width: auto;\n  min-height: auto;\n  justify-self: start;\n  accent-color: var(--navy);\n}\n\n.finance-form-meta,\n.finance-form-actions,\n.record-actions,\n.verification-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n  align-items: flex-start;\n}\n\n.action-button,\n.record-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.45rem;\n  border: 1px solid rgba(11, 37, 69, 0.1);\n  border-radius: 999px;\n  padding: 0.65rem 0.95rem;\n  background: #ffffff;\n  color: var(--navy);\n  font-size: 0.74rem;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  transition:\n    transform 160ms ease,\n    background-color 160ms ease,\n    color 160ms ease,\n    border-color 160ms ease,\n    box-shadow 160ms ease,\n    opacity 160ms ease;\n}\n\n.action-button.primary {\n  background: var(--navy);\n  border-color: var(--navy);\n  color: var(--white);\n}\n\n.action-button:hover,\n.record-button:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 18px rgba(11, 37, 69, 0.08);\n}\n\n.action-button:active,\n.record-button:active {\n  transform: translateY(0) scale(0.98);\n}\n\n.action-button:focus-visible,\n.record-button:focus-visible,\n.shortcut-button:focus-visible,\n.mobile-sheet-close:focus-visible,\n.mobile-action-screen-close:focus-visible,\n.driver-fullscreen-back:focus-visible,\n.driver-quick-action-button:focus-visible {\n  outline: 3px solid rgba(27, 197, 189, 0.3);\n  outline-offset: 2px;\n}\n\n.record-button.danger {\n  color: var(--danger);\n  border-color: rgba(231, 76, 60, 0.2);\n}\n\n.action-button:disabled,\n.record-button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n.finance-form-note {\n  margin: 0;\n  font-size: 0.84rem;\n  line-height: 1.45;\n  font-weight: 700;\n}\n\n.finance-form-note[data-tone=\"info\"] {\n  color: var(--subtext);\n}\n\n.finance-form-note[data-tone=\"success\"] {\n  color: var(--success);\n}\n\n.finance-form-note[data-tone=\"warning\"] {\n  color: var(--warning);\n}\n\n.finance-form-note[data-tone=\"danger\"] {\n  color: var(--danger);\n}\n\n.ledger-row {\n  display: grid;\n  gap: 0.7rem;\n  padding: 0.85rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  border-radius: 0.95rem;\n  background: rgba(245, 247, 250, 0.78);\n}\n\n.ledger-copy,\n.ledger-meta {\n  display: grid;\n  gap: 0.2rem;\n}\n\n.ledger-copy strong,\n.ledger-meta strong {\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 0.98rem;\n}\n\n.ledger-copy span,\n.ledger-meta span {\n  color: var(--subtext);\n  font-size: 0.8rem;\n}\n\n.verification-input {\n  flex: 1 1 10rem;\n  min-height: 2.65rem;\n  padding: 0.65rem 0.8rem;\n  border: 1px solid rgba(11, 37, 69, 0.1);\n  border-radius: 0.85rem;\n  background: rgba(245, 247, 250, 0.9);\n  color: var(--navy);\n}\n\n.fleet-counter-grid,\n.fleet-management-grid {\n  display: grid;\n  gap: 0.85rem;\n}\n\n.vehicle-summary-card {\n  display: grid;\n  gap: 0.8rem;\n  width: 100%;\n  padding: 0.95rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: #ffffff;\n  text-align: left;\n  box-shadow: 0 6px 16px rgba(11, 37, 69, 0.04);\n}\n\n.vehicle-summary-card.active {\n  border-color: rgba(11, 37, 69, 0.22);\n  box-shadow: 0 10px 22px rgba(11, 37, 69, 0.08);\n}\n\n.vehicle-summary-trigger {\n  display: grid;\n  gap: 0.8rem;\n  width: 100%;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  text-align: left;\n}\n\n.vehicle-summary-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 0.8rem;\n}\n\n.vehicle-summary-top strong {\n  display: block;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1rem;\n}\n\n.vehicle-summary-top span {\n  display: block;\n  margin-top: 0.28rem;\n  color: var(--subtext);\n  font-size: 0.82rem;\n}\n\n.vehicle-summary-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n}\n\n.vehicle-summary-actions .action-button {\n  margin-top: 0;\n}\n\n.content-stack,\n.two-up,\n.loop-grid,\n.timeline-list,\n.list-stack,\n.queue-grid,\n.fleet-grid,\n.traffic-grid,\n.shortcut-grid,\n.bars-stack {\n  display: grid;\n  gap: 1rem;\n}\n\n.overview-board-grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.overview-board {\n  display: grid;\n  gap: 0.85rem;\n  align-content: start;\n  padding: 0.95rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: #ffffff;\n  box-shadow: 0 6px 16px rgba(11, 37, 69, 0.04);\n}\n\n.fleet-health-card {\n  position: relative;\n  overflow: hidden;\n}\n\n.fleet-health-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 0.28rem;\n  border-radius: 1rem 0 0 1rem;\n}\n\n.fleet-health-card[data-tone=\"success\"] {\n  border-color: rgba(39, 174, 96, 0.24);\n  background: linear-gradient(180deg, rgba(39, 174, 96, 0.12), rgba(39, 174, 96, 0.04));\n}\n\n.fleet-health-card[data-tone=\"success\"]::before {\n  background: linear-gradient(180deg, var(--success), #4cc37c);\n}\n\n.fleet-health-card[data-tone=\"success\"] .eyebrow,\n.fleet-health-card[data-tone=\"success\"] h3 {\n  color: #17663a;\n}\n\n.fleet-health-card[data-tone=\"warning\"] {\n  border-color: rgba(243, 156, 18, 0.28);\n  background: linear-gradient(180deg, rgba(243, 156, 18, 0.14), rgba(243, 156, 18, 0.05));\n}\n\n.fleet-health-card[data-tone=\"warning\"]::before {\n  background: linear-gradient(180deg, var(--warning), #f6b13d);\n}\n\n.fleet-health-card[data-tone=\"warning\"] .eyebrow,\n.fleet-health-card[data-tone=\"warning\"] h3 {\n  color: #9b5d00;\n}\n\n.fleet-health-card[data-tone=\"danger\"] {\n  border-color: rgba(231, 76, 60, 0.26);\n  background: linear-gradient(180deg, rgba(231, 76, 60, 0.13), rgba(231, 76, 60, 0.05));\n}\n\n.fleet-health-card[data-tone=\"danger\"]::before {\n  background: linear-gradient(180deg, var(--danger), #ee6d61);\n}\n\n.fleet-health-card[data-tone=\"danger\"] .eyebrow,\n.fleet-health-card[data-tone=\"danger\"] h3 {\n  color: #9f2f23;\n}\n\n.overview-board-head {\n  display: grid;\n  gap: 0.25rem;\n}\n\n.overview-board-head h3 {\n  margin: 0;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1rem;\n  letter-spacing: -0.02em;\n}\n\n.panel-card {\n  padding: 1.3rem;\n}\n\n.insight-card {\n  position: relative;\n  display: grid;\n  gap: 0.85rem;\n  min-height: 10.25rem;\n  padding: 0.9rem 0.95rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: #ffffff;\n  box-shadow: 0 6px 16px rgba(11, 37, 69, 0.04);\n}\n\n.insight-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 0.24rem;\n  border-radius: 1rem 0 0 1rem;\n  background: rgba(11, 37, 69, 0.08);\n}\n\n.insight-card[data-tone=\"success\"]::before {\n  background: linear-gradient(180deg, var(--success), #4cc37c);\n}\n\n.insight-card[data-tone=\"warning\"]::before {\n  background: linear-gradient(180deg, var(--warning), #f6b13d);\n}\n\n.insight-card[data-tone=\"danger\"]::before {\n  background: linear-gradient(180deg, var(--danger), #ee6d61);\n}\n\n.insight-card[data-tone=\"info\"]::before {\n  background: linear-gradient(180deg, var(--info), #59ade6);\n}\n\n.insight-card[data-tone=\"navy\"]::before {\n  background: linear-gradient(180deg, var(--navy), #173861);\n}\n\n.insight-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 1rem;\n}\n\n.insight-head strong {\n  display: block;\n  margin-top: 0.2rem;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1.35rem;\n  line-height: 1;\n}\n\n.insight-head span {\n  display: block;\n  margin-top: 0.35rem;\n  color: var(--muted);\n  font-size: 0.64rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.insight-visual {\n  min-height: 6rem;\n  display: grid;\n  align-items: end;\n}\n\n.panel-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n\n.panel-head h2 {\n  color: var(--navy);\n  font-size: 1.45rem;\n}\n\n.feature-card,\n.loop-card,\n.architecture-card,\n.queue-card,\n.vehicle-card,\n.traffic-card,\n.deposit-card,\n.terminal-card {\n  border-radius: 1.2rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(247, 249, 251, 1));\n}\n\n.feature-card,\n.architecture-card,\n.traffic-card {\n  padding: 1rem;\n}\n\n.feature-card h3,\n.loop-card h3,\n.architecture-card h3,\n.traffic-card h3 {\n  margin: 0 0 0.35rem;\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  color: var(--navy);\n  font-size: 1rem;\n}\n\n.feature-card p,\n.architecture-card p,\n.traffic-card p {\n  line-height: 1.55;\n}\n\n.status-row,\n.person-row {\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n  padding: 1rem;\n  border-radius: 1.2rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: rgba(245, 245, 245, 0.78);\n}\n\n.status-title-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.7rem;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.45rem;\n}\n\n.status-row h3,\n.timeline-row h3,\n.person-row h3 {\n  font-size: 1rem;\n  color: var(--navy);\n}\n\n.status-row p,\n.timeline-row p,\n.status-meta {\n  font-size: 0.92rem;\n  line-height: 1.55;\n}\n\n.status-meta {\n  color: var(--muted);\n  font-weight: 700;\n}\n\n.loop-card {\n  padding: 1rem;\n  display: grid;\n  gap: 0.65rem;\n}\n\n.loop-grid.compact {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.loop-card.compact {\n  gap: 0.45rem;\n}\n\n.loop-card.compact p {\n  display: none;\n}\n\n.loop-card[data-tone=\"teal\"] {\n  background: linear-gradient(180deg, rgba(27, 197, 189, 0.12), rgba(255, 255, 255, 0.98));\n}\n\n.loop-card[data-tone=\"gold\"] {\n  background: linear-gradient(180deg, rgba(244, 208, 63, 0.16), rgba(255, 255, 255, 0.98));\n}\n\n.loop-card[data-tone=\"navy\"] {\n  background: linear-gradient(180deg, rgba(11, 37, 69, 0.12), rgba(255, 255, 255, 0.98));\n}\n\n.step-number {\n  display: inline-flex;\n  align-items: center;\n  width: -moz-fit-content;\n  width: fit-content;\n  border-radius: 999px;\n  padding: 0.4rem 0.7rem;\n  background: rgba(255, 255, 255, 0.92);\n  color: var(--navy);\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.timeline-row {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 0.85rem;\n  align-items: flex-start;\n}\n\n.timeline-dot {\n  width: 0.8rem;\n  height: 0.8rem;\n  margin-top: 0.35rem;\n  border-radius: 999px;\n  background: linear-gradient(135deg, var(--teal), var(--navy));\n  box-shadow: 0 0 0 0.35rem rgba(27, 197, 189, 0.12);\n}\n\n.cta-link {\n  margin-top: 1rem;\n  width: -moz-fit-content;\n  width: fit-content;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.85rem 1rem;\n  border-radius: 1rem;\n  background: rgba(11, 37, 69, 0.06);\n  color: var(--navy);\n  font-weight: 700;\n}\n\n.module-quick-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  margin-top: 1rem;\n}\n\n.module-quick-links.stack {\n  display: grid;\n  gap: 0.6rem;\n}\n\n.flow-strip {\n  display: grid;\n  gap: 0.55rem;\n}\n\n.flow-step,\n.flow-lane {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding: 0.72rem 0.85rem;\n  border-radius: 0.8rem;\n  border: 1px solid rgba(11, 37, 69, 0.06);\n}\n\n.flow-step span,\n.flow-lane span {\n  color: var(--muted);\n  font-size: 0.64rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.flow-step strong,\n.flow-lane strong {\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 0.88rem;\n}\n\n.flow-step[data-tone=\"teal\"],\n.flow-lane[data-tone=\"teal\"] {\n  background: rgba(27, 197, 189, 0.1);\n}\n\n.flow-step[data-tone=\"gold\"],\n.flow-lane[data-tone=\"gold\"] {\n  background: rgba(244, 208, 63, 0.16);\n}\n\n.flow-step[data-tone=\"navy\"],\n.flow-lane[data-tone=\"navy\"] {\n  background: rgba(11, 37, 69, 0.08);\n}\n\n.compact-feed {\n  display: grid;\n  gap: 0.65rem;\n}\n\n.compact-feed-item {\n  display: grid;\n  gap: 0.55rem;\n  padding: 0.85rem;\n  border-radius: 0.85rem;\n  background: #f8f7f8;\n  border: 1px solid rgba(11, 37, 69, 0.06);\n}\n\n.compact-feed-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.compact-feed-item h4 {\n  margin: 0;\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 0.82rem;\n  letter-spacing: -0.01em;\n}\n\n.compact-feed-item p {\n  margin: 0.25rem 0 0;\n  color: var(--muted);\n  font-size: 0.68rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.compact-badge {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 999px;\n  padding: 0.28rem 0.52rem;\n  font-size: 0.58rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #ffffff;\n}\n\n.compact-badge[data-tone=\"success\"] {\n  background: var(--success);\n}\n\n.compact-badge[data-tone=\"warning\"] {\n  background: var(--warning);\n}\n\n.compact-badge[data-tone=\"danger\"] {\n  background: var(--danger);\n}\n\n.compact-badge[data-tone=\"info\"] {\n  background: var(--info);\n}\n\n.compact-meta {\n  color: var(--subtext);\n  font-size: 0.75rem;\n  font-weight: 700;\n}\n\n.cta-link:hover,\n.shortcut-button:hover,\n.bottom-nav-item:hover {\n  transform: translateY(-1px);\n}\n\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  width: -moz-fit-content;\n  width: fit-content;\n  border-radius: 999px;\n  padding: 0.45rem 0.8rem;\n  color: var(--white);\n  font-size: 0.76rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.mini-bars {\n  display: flex;\n  align-items: end;\n  gap: 0.85rem;\n  min-height: 7rem;\n}\n\n.mini-bars.compare {\n  gap: 0.65rem;\n}\n\n.mini-bar-group {\n  flex: 1;\n  display: grid;\n  justify-items: center;\n  gap: 0.55rem;\n}\n\n.mini-bar-group span {\n  color: var(--muted);\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.mini-bar-track.vertical {\n  width: 100%;\n  max-width: 3rem;\n  height: 5.75rem;\n  display: flex;\n  align-items: end;\n  justify-content: center;\n  border-radius: 999px;\n  background: rgba(11, 37, 69, 0.08);\n  overflow: hidden;\n}\n\n.mini-bar-track.vertical.compare {\n  align-items: end;\n  gap: 0.2rem;\n  padding: 0.4rem;\n}\n\n.mini-bar-fill {\n  width: 100%;\n  border-radius: 999px 999px 0 0;\n}\n\n.mini-bar-fill[data-tone=\"success\"] {\n  background: linear-gradient(180deg, #6ad49b, var(--success));\n}\n\n.mini-bar-fill[data-tone=\"warning\"] {\n  background: linear-gradient(180deg, #f7c96f, var(--warning));\n}\n\n.mini-bar-fill[data-tone=\"danger\"] {\n  background: linear-gradient(180deg, #f08b81, var(--danger));\n}\n\n.mini-bar-fill[data-tone=\"info\"] {\n  background: linear-gradient(180deg, #78bff0, var(--info));\n}\n\n.mini-bar-fill[data-tone=\"navy\"] {\n  background: linear-gradient(180deg, #35557f, var(--navy));\n}\n\n.mini-bar-fill.primary,\n.mini-bar-fill.secondary {\n  width: calc(50% - 0.1rem);\n}\n\n.mini-bar-fill.secondary {\n  opacity: 0.45;\n}\n\n.segment-meter {\n  display: grid;\n  gap: 0.8rem;\n}\n\n.segment-bar {\n  display: flex;\n  width: 100%;\n  height: 0.9rem;\n  border-radius: 999px;\n  overflow: hidden;\n  background: rgba(11, 37, 69, 0.06);\n}\n\n.segment-piece[data-tone=\"success\"],\n.segment-label i[data-tone=\"success\"] {\n  background: var(--success);\n}\n\n.segment-piece[data-tone=\"warning\"],\n.segment-label i[data-tone=\"warning\"] {\n  background: var(--warning);\n}\n\n.segment-piece[data-tone=\"danger\"],\n.segment-label i[data-tone=\"danger\"] {\n  background: var(--danger);\n}\n\n.segment-piece[data-tone=\"info\"],\n.segment-label i[data-tone=\"info\"] {\n  background: var(--info);\n}\n\n.segment-piece[data-tone=\"navy\"],\n.segment-label i[data-tone=\"navy\"] {\n  background: var(--navy);\n}\n\n.segment-legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.8rem;\n}\n\n.segment-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  color: var(--muted);\n  font-size: 0.74rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.segment-label i {\n  display: inline-block;\n  width: 0.65rem;\n  height: 0.65rem;\n  border-radius: 999px;\n}\n\n.ring-wrap {\n  display: grid;\n  justify-items: center;\n  gap: 0.65rem;\n}\n\n.ring-meter {\n  display: grid;\n  place-items: center;\n  width: 6.4rem;\n  height: 6.4rem;\n  border-radius: 999px;\n}\n\n.ring-core {\n  display: grid;\n  place-items: center;\n  width: 4.5rem;\n  height: 4.5rem;\n  border-radius: 999px;\n  background: var(--white);\n  box-shadow: inset 0 0 0 1px rgba(11, 37, 69, 0.05);\n}\n\n.ring-core strong {\n  color: var(--navy);\n  font-family: \"Bahnschrift\", \"Aptos Display\", sans-serif;\n  font-size: 1.1rem;\n}\n\n.ring-subtitle {\n  color: var(--muted);\n  font-size: 0.74rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.queue-card,\n.vehicle-card,\n.deposit-card,\n.terminal-card {\n  padding: 1rem;\n}\n\n.queue-header,\n.vehicle-header,\n.terminal-header,\n.queue-footer,\n.deposit-row,\n.deposit-meta,\n.bar-copy,\n.person-metrics {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.85rem;\n}\n\n.queue-header,\n.vehicle-header,\n.terminal-header {\n  align-items: flex-start;\n}\n\n.queue-header h3,\n.vehicle-header h3,\n.terminal-header h3 {\n  font-size: 1.05rem;\n  color: var(--navy);\n}\n\n.queue-header p,\n.vehicle-header p,\n.terminal-header p {\n  margin-top: 0.3rem;\n  font-size: 0.92rem;\n}\n\n.queue-stats,\n.vehicle-metrics {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.75rem;\n  margin-top: 1rem;\n}\n\n.queue-stats.compact {\n  margin-top: 0;\n}\n\n.info-pair {\n  display: grid;\n  gap: 0.25rem;\n  padding: 0.8rem;\n  border-radius: 1rem;\n  background: rgba(245, 245, 245, 0.92);\n}\n\n.info-pair span {\n  color: var(--muted);\n  font-size: 0.74rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.info-pair strong {\n  color: var(--navy);\n  font-size: 0.95rem;\n}\n\n.queue-footer {\n  margin-top: 1rem;\n  flex-wrap: wrap;\n  color: var(--subtext);\n  font-size: 0.9rem;\n}\n\n.queue-inline {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  font-weight: 700;\n}\n\n.deposit-card {\n  display: grid;\n  gap: 0.8rem;\n  background: linear-gradient(180deg, rgba(11, 37, 69, 0.03), rgba(255, 255, 255, 0.98));\n}\n\n.deposit-row span,\n.panel-note {\n  font-size: 0.94rem;\n  line-height: 1.55;\n}\n\n.deposit-row strong {\n  color: var(--navy);\n  font-size: 1rem;\n}\n\n.deposit-row.total {\n  padding-top: 0.85rem;\n  border-top: 1px solid rgba(11, 37, 69, 0.08);\n}\n\n.deposit-row.total strong {\n  font-size: 1.3rem;\n}\n\n.bar-row {\n  display: grid;\n  gap: 0.55rem;\n}\n\n.bar-track {\n  width: 100%;\n  height: 0.85rem;\n  border-radius: 999px;\n  background: rgba(11, 37, 69, 0.08);\n  overflow: hidden;\n}\n\n.bar-fill {\n  height: 100%;\n  border-radius: inherit;\n}\n\n.utilisation {\n  margin-top: 1rem;\n}\n\n.traffic-card[data-tone=\"danger\"] {\n  background: linear-gradient(180deg, rgba(231, 76, 60, 0.12), rgba(255, 255, 255, 0.98));\n}\n\n.traffic-card[data-tone=\"warning\"] {\n  background: linear-gradient(180deg, rgba(243, 156, 18, 0.14), rgba(255, 255, 255, 0.98));\n}\n\n.traffic-card[data-tone=\"info\"] {\n  background: linear-gradient(180deg, rgba(52, 152, 219, 0.12), rgba(255, 255, 255, 0.98));\n}\n\n.traffic-card[data-tone=\"success\"] {\n  background: linear-gradient(180deg, rgba(39, 174, 96, 0.12), rgba(255, 255, 255, 0.98));\n}\n\n.shortcut-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-top: 1rem;\n}\n\n.shortcut-grid.compact {\n  margin-top: 0;\n}\n\n.shortcut-button {\n  padding: 0.95rem;\n  border-radius: 1rem;\n  background: linear-gradient(135deg, rgba(27, 197, 189, 0.14), rgba(11, 37, 69, 0.06));\n  color: var(--navy);\n  font-weight: 700;\n}\n\n.shortcut-button:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 12px 22px rgba(11, 37, 69, 0.08);\n}\n\n.shortcut-button:active {\n  transform: scale(0.98);\n}\n\n.driver-action-panel {\n  display: grid;\n  gap: 0.85rem;\n  margin-top: 1rem;\n  padding-top: 1rem;\n  border-top: 1px solid rgba(11, 37, 69, 0.08);\n}\n\n.driver-quick-actions-grid {\n  display: grid;\n  /* Container-responsive: avoid 2-up when the host panel is narrow (even on desktop). */\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n  gap: 0.7rem;\n}\n\n.driver-quick-action-button {\n  position: relative;\n  min-height: 5.75rem;\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  gap: 0.75rem;\n  align-items: center;\n  padding: 1rem;\n  border-radius: 0.75rem;\n  border: 1px solid rgba(11, 37, 69, 0.08);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 250, 0.98));\n  color: var(--navy);\n  text-align: left;\n  box-shadow: 0 10px 20px rgba(11, 37, 69, 0.05);\n  touch-action: manipulation;\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n  transition:\n    transform 160ms ease,\n    box-shadow 160ms ease,\n    border-color 160ms ease,\n    background 160ms ease,\n    color 160ms ease,\n    opacity 160ms ease;\n}\n\n.driver-quick-action-button:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 16px 28px rgba(11, 37, 69, 0.1);\n  border-color: rgba(11, 37, 69, 0.16);\n}\n\n.driver-quick-action-button:active {\n  transform: translateY(0) scale(0.975);\n  box-shadow: 0 8px 18px rgba(11, 37, 69, 0.12);\n}\n\n.driver-quick-action-button:focus-visible {\n  outline-offset: 3px;\n  box-shadow:\n    0 0 0 4px rgba(27, 197, 189, 0.14),\n    0 14px 28px rgba(11, 37, 69, 0.12);\n}\n\n.driver-quick-action-button:disabled {\n  opacity: 0.62;\n  cursor: not-allowed;\n  box-shadow: none;\n  transform: none;\n}\n\n.driver-quick-action-button[data-disabled=\"true\"] {\n  background: linear-gradient(180deg, rgba(246, 248, 251, 0.98), rgba(237, 241, 246, 0.98));\n  color: rgba(11, 37, 69, 0.7);\n}\n\n.driver-quick-action-button[data-tone=\"success\"] .driver-quick-action-icon {\n  background: rgba(39, 174, 96, 0.12);\n  color: var(--success);\n}\n\n.driver-quick-action-button[data-tone=\"warning\"] .driver-quick-action-icon {\n  background: rgba(243, 156, 18, 0.12);\n  color: var(--warning);\n}\n\n.driver-quick-action-button[data-tone=\"navy\"] .driver-quick-action-icon {\n  backgro